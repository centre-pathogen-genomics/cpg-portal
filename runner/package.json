{
  "name": "cpg-runner",
  "private": true,
  "version": "1.0.0",
  "description": "CPG Runner desktop shell: Electron around the local tool sidecar",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "build": "bun run build:renderer && bun run build:main",
    "build:renderer": "vite build --config renderer/vite.config.ts",
    "build:main": "bun build ./electron/main.ts ./electron/preload.ts --outdir dist/electron --target node --format cjs --external electron",
    "package": "bun run build && electron-builder --config electron-builder.yml",
    "dev:renderer": "vite --config renderer/vite.config.ts"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-router": "^1.170.15",
    "@types/node": "^25.9.2",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19.2.17",
    "@types/react-copy-to-clipboard": "^5.0.7",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "45.2.3",
    "electron-builder": "^26.18.0",
    "lucide-react": "^1.17.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-copy-to-clipboard": "^5.1.0",
    "react-dom": "^19.2.7",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^15.6.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "@jbrowse/bandage-core": "^14.0.0",
    "@phylocanvas/phylocanvas.gl": "^1.64.1",
    "@radix-ui/react-checkbox": "^1.3.4",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.14",
    "@radix-ui/react-tooltip": "^1.2.9",
    "@tanstack/react-query": "^5.101.0",
    "papaparse": "^5.4.1",
    "radix-ui": "^1.6.7",
    "react-hook-form": "^7.78.0",
    "react-vega": "^8.0.0",
    "seqparse": "^0.2.1",
    "seqviz": "^3.10.10",
    "vega-embed": "^7.1.0",
    "vega-lite": "^6.4.1"
  }
}
