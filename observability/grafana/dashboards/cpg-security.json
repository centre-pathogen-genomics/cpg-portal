{
  "uid": "cpg-security",
  "title": "CPG Portal — Security & Observability",
  "tags": ["cpg", "security"],
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "timezone": "browser",
  "editable": true,
  "__inputs": [],
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "Requests (all statuses)",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [
        { "expr": "count_over_time({event=\"access\"}[$__interval])", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "title": "Requests by status code",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "sum by (status) (rate({event=\"access\"}[$__interval]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP errors (4xx/5xx)",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "count_over_time({event=\"access\",status=~\"4[0-9][0-9]|5[0-9][0-9]\"}[$__interval])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Top client IPs",
      "type": "barchart",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "options": { "orientation": "horizontal" },
      "targets": [
        {
          "expr": "topk(10, sum by (client_ip) (count_over_time({event=\"access\"}[$__range])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Login successes",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "count_over_time({event=\"login.success\"}[$__interval])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Login failures",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "targets": [
        {
          "expr": "count_over_time({event=\"login.failed\"}[$__interval])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Access / permission denials",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "count_over_time({event=~\"auth.permission_denied|access.file_denied|access.run_denied\"}[$__interval])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Rejected tokens",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 16 },
      "targets": [
        {
          "expr": "count_over_time({event=\"auth.token_rejected\"}[$__interval])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Job submissions",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "count_over_time({event=\"run.submit\"}[$__interval])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "File uploads",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 16 },
      "targets": [
        {
          "expr": "count_over_time({event=\"file.upload\"}[$__interval])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Recent security events",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "{event=~\"auth.*|access.*|login.*|run.submit|file.upload\"}",
          "refId": "A",
          "range": true
        }
      ],
      "options": { "showTime": true, "showLabels": false, "enableLogDetails": true }
    }
  ]
}